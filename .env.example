# Formal/local runtime database. Keep the real password outside Git.
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5432/english_analyzer
EXPECTED_DATABASE_DIALECT=postgresql
EXPECTED_DATABASE_NAME=english_analyzer
EXPECTED_DATABASE_SCHEMA=public
REQUIRED_ALEMBIC_REVISION=f5a6b7c8d9e
# SQLite is permitted only for isolated tests with APP_ENV=test.
ALLOW_SQLITE_FOR_TESTS=false
APP_ENV=development
PUBLIC_DEV_MODE=false
PUBLIC_BASE_URL=http://127.0.0.1:5173
WEB_DIST_DIR=../English-study-web/dist
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
MAX_REQUEST_BODY_BYTES=1048576

TRANSLATION_PROVIDER=argos
EXAMPLE_GENERATOR_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=50
OLLAMA_TEMPERATURE=0.3
OLLAMA_THINK=false

ENABLE_TENCENT_TMT=false
ENABLE_HUNYUAN=false

# WeChat login still requires real Mini Program credentials in local DevTools.
WECHAT_APPID=your_wechat_miniapp_appid_here
WECHAT_SECRET=your_wechat_miniapp_secret_here

JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Web authentication. Generate a different long random value for each real
# environment. Never commit the actual value.
SESSION_SECRET_KEY=change_me_to_a_different_long_random_secret
SESSION_COOKIE_NAME=english_study_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Phase 1 development provider logs verification/reset links server-side.
# It does not send real email. For public use select smtp and configure the
# existing SMTP provider with secrets supplied outside Git.
MAIL_PROVIDER=development
MAIL_FROM_ADDRESS=noreply@example.invalid
# Optional controlled development-only log. It contains one-time links; keep it out of Git.
DEVELOPMENT_MAIL_LOG_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

AUTH_RATE_LIMIT_PER_15_MINUTES=20
EMAIL_RATE_LIMIT_PER_HOUR=5
AI_DAILY_QUOTA=30
TTS_DAILY_QUOTA=100
LEXICAL_DAILY_QUOTA=500
AI_GLOBAL_CONCURRENCY=1
TTS_GLOBAL_CONCURRENCY=2
RESOURCE_QUEUE_TIMEOUT_SECONDS=3

PIPER_CACHE_MAX_BYTES=536870912
PIPER_CACHE_MAX_AGE_DAYS=30

# Legacy / optional cloud providers. They are kept for rollback only and are
# not required in the default local mode above.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TMT_REGION=ap-guangzhou
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-role-latest
